# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/campus-auction

# Auth
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI (Optional — app works without it)
GEMINI_API_KEY=your-gemini-key

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email / SMTP for OTP Verification (Optional — in dev mode, OTP is printed to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Campus Auction <noreply@campusauction.edu>"
